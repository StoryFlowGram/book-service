# Database
BOOK_DB_USER=book_user
BOOK_DB_PASSWORD=book_password
BOOK_DB_NAME=book-db
BOOK_DB_HOST=book-db

# Internal security
INTERNAL_GATEWAY_TOKEN=replace_with_internal_gateway_token

# Task processing / RabbitMQ
TASKIQ_BROKER_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
TASKIQ_STARTUP_CONNECT_RETRIES=20
TASKIQ_STARTUP_CONNECT_DELAY_SECONDS=2
SEARCH_BOOK_EVENTS_QUEUE=sfg.book-search-updates

# Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_REGION_NAME=us-east-1
S3_BUCKET_NAME=chapters
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_PUBLIC=false
S3_PRESIGNED_EXPIRES_SECONDS=900
S3_PUBLIC_ENDPOINT_URL=

# Upload limits
BOOK_UPLOAD_MAX_SIZE_BYTES=52428800
